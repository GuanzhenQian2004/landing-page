---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Keep a page out of search results (internal/preview pages). */
  noindex?: boolean;
}

const {
  title = 'Steven Qian',
  description = 'Portfolio of Steven Qian — software development, machine learning, cloud computing, and data analysis.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Steven Qian" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="theme-color" content="#f5f5f5" />

    <!-- Fonts: EB Garamond 300 (display, Waldenburg Light substitute) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Smooth cross-page transitions -->
    <ClientRouter />

    <style is:global>
      /* Cross-fade pages, but hold still for reduced-motion users.
         ClientRouter drives the transition — do NOT also declare
         `@view-transition { navigation: auto }`, which double-handles
         navigation and can leave a stuck snapshot over the page. */
      ::view-transition-old(root) {
        animation: page-out 0.25s var(--ease) both;
      }
      ::view-transition-new(root) {
        animation: page-in 0.35s var(--ease) both;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scroll-driven motion: reveals, staggered grids, orb parallax -->
    <script>
      function initMotion() {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const targets = document.querySelectorAll('.reveal, .stagger');
        if (reduced) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((el) => io.observe(el));

        // Gentle parallax on the atmospheric orbs.
        const orbs = Array.from(document.querySelectorAll<HTMLElement>('.orb'));
        if (orbs.length) {
          let ticking = false;
          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              const y = window.scrollY;
              orbs.forEach((orb, i) => {
                const depth = 0.04 + (i % 3) * 0.03;
                orb.style.translate = `0 ${(-y * depth).toFixed(1)}px`;
              });
              ticking = false;
            });
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      }

      initMotion();
      // Re-run after client-side navigation (view transitions swap the DOM).
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
