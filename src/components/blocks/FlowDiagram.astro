---
// Animated pipeline/architecture diagram.
//
// Renders a sequence of labeled stages with connectors that draw themselves in
// as the block scrolls into view. Two motion variants:
//   calm — fades and draws once, then rests (matches the editorial system)
//   bold — spring easing, pastel tints, and a dot that keeps travelling
//
// Motion is decorative only: frozen (or under prefers-reduced-motion) the
// diagram still reads correctly, so nothing is conveyed by movement alone.
interface Stage {
  label: string;
  detail?: string;
}
interface Props {
  title?: string;
  caption?: string;
  stages: Stage[];
  variant?: 'calm' | 'bold';
}
const { title, caption, stages, variant = 'calm' } = Astro.props;
---

<figure class={`flow flow--${variant} reveal`}>
  {title && <div class="caption-uppercase flow__title">{title}</div>}

  <ol class="flow__track">
    {
      stages.map((stage, i) => (
        <li class="flow__stage" style={`--i:${i}`}>
          <div class="flow__card">
            <span class="flow__num">{String(i + 1).padStart(2, '0')}</span>
            <h4 class="flow__label">{stage.label}</h4>
            {stage.detail && <p class="flow__detail">{stage.detail}</p>}
          </div>

          {i < stages.length - 1 && (
            <span class="flow__link" aria-hidden="true">
              <span class="flow__line" />
              <span class="flow__dot" />
              <span class="flow__arrow" />
            </span>
          )}
        </li>
      ))
    }
  </ol>

  {caption && <figcaption class="caption flow__caption">{caption}</figcaption>}
</figure>

<style>
  .flow {
    margin: var(--s-xl) 0;
  }
  .flow__title {
    color: var(--muted-soft);
    margin-bottom: var(--s-base);
  }
  .flow__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: stretch;
  }
  .flow__stage {
    flex: 1;
    display: flex;
    /* Stretch so every card is the same height regardless of detail length —
       centering instead leaves the row looking accidentally staggered. */
    align-items: stretch;
    min-width: 0;
  }
  .flow__card {
    flex: 1;
    min-width: 0;
    background: var(--surface-card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    padding: var(--s-base);
  }
  .flow__num {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: var(--muted-soft);
    margin-bottom: var(--s-xs);
  }
  .flow__label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
  }
  .flow__detail {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Connector ------------------------------------------------------- */
  .flow__link {
    position: relative;
    flex: 0 0 44px;
    height: 1px;
    display: flex;
    align-items: center;
    /* Cards stretch; the connector stays on the centre line. */
    align-self: center;
  }
  .flow__line {
    position: absolute;
    inset: 0;
    background: var(--hairline-strong);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .flow__arrow {
    position: absolute;
    right: 0;
    width: 5px;
    height: 5px;
    border-top: 1px solid var(--hairline-strong);
    border-right: 1px solid var(--hairline-strong);
    rotate: 45deg;
    opacity: 0;
  }
  .flow__dot {
    position: absolute;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0;
  }

  /* Entrance -------------------------------------------------------- */
  .flow__card {
    opacity: 0;
    transform: translateY(12px);
  }
  .flow.is-visible .flow__card {
    opacity: 1;
    transform: none;
  }
  .flow.is-visible .flow__line {
    transform: scaleX(1);
  }
  .flow.is-visible .flow__arrow {
    opacity: 1;
  }

  /* Calm: everything settles once and stays put. */
  .flow--calm .flow__card {
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    transition-delay: calc(var(--i) * 0.14s);
  }
  .flow--calm .flow__line {
    transition: transform 0.45s var(--ease);
    transition-delay: calc(var(--i) * 0.14s + 0.3s);
  }
  .flow--calm .flow__arrow {
    transition: opacity 0.2s var(--ease);
    transition-delay: calc(var(--i) * 0.14s + 0.7s);
  }

  /* Bold: springier, tinted, and the dot keeps moving. */
  .flow--bold .flow__card {
    transition: opacity 0.5s var(--ease), transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * 0.11s);
  }
  .flow--bold.is-visible .flow__card {
    transform: none;
  }
  .flow--bold .flow__line {
    transition: transform 0.4s cubic-bezier(0.34, 1.3, 0.64, 1);
    transition-delay: calc(var(--i) * 0.11s + 0.24s);
  }
  .flow--bold .flow__arrow {
    transition: opacity 0.2s var(--ease);
    transition-delay: calc(var(--i) * 0.11s + 0.6s);
  }
  /* Pastel tint per stage — a deliberate departure from the ink-only system. */
  .flow--bold .flow__stage:nth-child(1) .flow__card {
    background: linear-gradient(160deg, rgba(167, 229, 211, 0.22), var(--surface-card) 70%);
  }
  .flow--bold .flow__stage:nth-child(2) .flow__card {
    background: linear-gradient(160deg, rgba(168, 200, 232, 0.22), var(--surface-card) 70%);
  }
  .flow--bold .flow__stage:nth-child(3) .flow__card {
    background: linear-gradient(160deg, rgba(200, 184, 224, 0.22), var(--surface-card) 70%);
  }
  .flow--bold .flow__stage:nth-child(4) .flow__card {
    background: linear-gradient(160deg, rgba(244, 197, 168, 0.22), var(--surface-card) 70%);
  }
  .flow--bold .flow__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }
  /* Data travelling down the pipeline, looping. */
  .flow--bold.is-visible .flow__dot {
    animation: flow-dot 2.6s var(--ease) infinite;
    animation-delay: calc(var(--i) * 0.28s + 0.9s);
  }
  @keyframes flow-dot {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    12% {
      opacity: 1;
    }
    78% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(39px);
    }
  }

  .flow__caption {
    margin-top: var(--s-base);
    color: var(--muted);
  }

  /* Stack vertically on narrow screens. */
  @media (max-width: 760px) {
    .flow__track {
      flex-direction: column;
      align-items: stretch;
    }
    .flow__stage {
      flex-direction: column;
      align-items: stretch;
    }
    .flow__link {
      flex: 0 0 28px;
      width: 1px;
      height: 28px;
      margin-left: var(--s-lg);
    }
    .flow__line {
      transform: scaleY(0);
      transform-origin: top center;
    }
    .flow.is-visible .flow__line {
      transform: scaleY(1);
    }
    .flow__arrow {
      right: auto;
      bottom: 0;
      left: -2px;
      rotate: 135deg;
    }
    .flow--bold.is-visible .flow__dot {
      animation-name: flow-dot-v;
    }
    @keyframes flow-dot-v {
      0% {
        opacity: 0;
        transform: translate(-2px, 0);
      }
      12% {
        opacity: 1;
      }
      78% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        transform: translate(-2px, 24px);
      }
    }
  }

  /* Frozen state must still read as a diagram. */
  @media (prefers-reduced-motion: reduce) {
    .flow__card,
    .flow__line,
    .flow__arrow {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .flow__line {
      transform: scaleX(1);
    }
    .flow__dot {
      animation: none;
      opacity: 0;
    }
  }
</style>
